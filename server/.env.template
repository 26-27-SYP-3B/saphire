# Copy this file to `.env` and adjust values as needed.
# Values below match the built-in defaults in main.go.

# Port the HTTP server listens on
PORT=8080

# Location of the SQLite database file, relative to the project folder
SAPHIRE_DB_PATH=saphire.db

# Music library folder the server creates and saves every uploaded song in
SAPHIRE_LIBRARY_PATH=library
