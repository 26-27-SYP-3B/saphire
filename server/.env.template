# Copy this file to `.env` and adjust values as needed.
# Values below match the built-in defaults in src/db.rs and src/music.rs; `.env` is read on
# startup and a missing file is not an error. Paths are relative to the folder the server is
# started from.

# Port the HTTP server listens on
PORT=8080

# Location of the SQLite database file, relative to the folder the server is started from
SAPHIRE_DB_PATH=saphire.db

# Music library folder the server creates and saves every uploaded song in
SAPHIRE_LIBRARY_PATH=library

# When the server runs in the container (docker compose), the two paths above have to be
# absolute paths inside the mounted volumes — /data/saphire.db and /data/library — because a
# relative path is resolved in the container's working folder, which the service user cannot
# write to: the server answers "library: Permission denied" and does not start, and the data
# would not be on a volume either. The values here are the ones for `just run` on the host.
